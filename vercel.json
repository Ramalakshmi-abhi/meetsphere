{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "frontend/dist"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://meetsphere-production-6ae4.up.railway.app/api/$1"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "https://meetsphere-production-6ae4.up.railway.app/uploads/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
